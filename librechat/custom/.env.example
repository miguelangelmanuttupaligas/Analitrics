UID=1000
GID=1000
MONGO_UID=999
MONGO_GID=999
PORT=3080
APP_TITLE=Analitrics

# Plantilla local. Para la VM use .env.production.example.
# El gateway local se expone en 3090/3443.
GATEWAY_HTTP_PORT=3090
GATEWAY_HTTPS_PORT=3443
PUBLIC_HOST=analitrics-test.com

PUBLIC_PORT=3443
ANALITRICS_DEFAULT_TENANT_ID=analitrics
PUBLIC_ORIGIN=https://analitrics-test.com:3443

DOMAIN_CLIENT=https://analitrics-test.com:3443
DOMAIN_SERVER=https://analitrics-test.com:3443

# LibreChat Admin Panel is served under the same public origin.
ADMIN_PANEL_URL=https://analitrics-test.com:3443/admin
CUSTOM_FOOTER=""
ADMIN_PANEL_SESSION_SECRET=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
CREDS_KEY=replace-with-openssl-rand-hex-32
CREDS_IV=replace-with-openssl-rand-hex-16
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
SEARCH=false
USE_REDIS=false
USE_REDIS_STREAMS=false
RAG_PORT=8000
RAG_POSTGRES_DB=librechat
RAG_POSTGRES_USER=librechat
RAG_POSTGRES_PASSWORD=replace-with-openssl-rand-base64-36
ANALITRICS_POSTGRES_DB=analitrics
ANALITRICS_POSTGRES_ADMIN_USER=analitrics
ANALITRICS_POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-24
ANALITRICS_POSTGRES_USER=analitrics_runtime
ANALITRICS_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
ANALITRICS_POSTGRES_HOST_PORT=55432
ANALITRICS_RECONCILE_INTERVAL_SECONDS=21600
ANALITRICS_MAX_FILE_BYTES=26214400
ANALITRICS_MAX_ACTIVE_CHATS_PER_USER=50
ANALITRICS_MAX_USER_MESSAGES_PER_CHAT=100
ANALITRICS_MAX_MEMORY_ITEMS=20
ANALITRICS_MAX_MEMORY_CHARS=4000

# Analitrics LLM switch:
# - openai: uses OPENAI_API_KEY and ANALITRICS_*_MODEL variables.
# - local: uses an OpenAI-compatible local server such as Ollama, LM Studio, vLLM, or llama.cpp server.
ANALITRICS_LLM_PROVIDER=openai
# Host Ollama default. The host must allow Docker containers to reach this endpoint.
ANALITRICS_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
ANALITRICS_LOCAL_API_KEY=local-not-required
ANALITRICS_LOCAL_MODEL=qwen3:4b-instruct
ANALITRICS_CONVERSATION_PLANNER_MODEL_LOCAL=qwen3:4b-instruct
ANALITRICS_NL_SQL_MODEL_LOCAL=qwen2.5-coder:3b-instruct
ANALITRICS_ANSWER_MODEL_LOCAL=qwen3:4b-instruct
ANALITRICS_CRITIC_MODEL_LOCAL=qwen3:4b-instruct
ANALITRICS_LOCAL_USE_RESPONSE_FORMAT=false
ANALITRICS_CHARTS_ENABLED=false

# Optional local model overrides per step. If omitted, ANALITRICS_LOCAL_MODEL is used for every step.
# ANALITRICS_CONVERSATION_PLANNER_MODEL_LOCAL=qwen2.5-coder:7b
# ANALITRICS_NL_SQL_MODEL_LOCAL=qwen2.5-coder:7b
# ANALITRICS_ANSWER_MODEL_LOCAL=qwen2.5-coder:7b
# ANALITRICS_CRITIC_MODEL_LOCAL=qwen2.5-coder:7b
# ANALITRICS_CHART_SPEC_MODEL_LOCAL=qwen2.5-coder:7b

RUSTFS_ACCESS_KEY_ID=librechat
RUSTFS_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET_NAME=librechat
RUSTFS_CONSOLE_HOST_PORT=9001
RUSTFS_ANALYTICS_ACCESS_KEY_ID=analitrics-analytics-readonly
RUSTFS_ANALYTICS_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24

OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=replace-with-keycloak-client-secret

OPENID_ISSUER=https://analitrics-test.com:3443/auth/realms/analitrics
OPENID_SESSION_SECRET=replace-with-openssl-rand-hex-32
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Keycloak
OPENID_AUTO_REDIRECT=true
OPENID_REUSE_TOKENS=true

# Required so LibreChat logout also closes the Keycloak SSO session.
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_POST_LOGOUT_REDIRECT_URI=https://analitrics-test.com:3443/login?redirect=false

# Future admin elevation from Keycloak:
# 1. Create a Keycloak group or role, for example analitrics-admins.
# 2. Emit it in the ID token as claim groups.
# 3. Uncomment these so LibreChat promotes matching users to ADMIN on login.
# OPENID_ADMIN_ROLE=analitrics-admins
# OPENID_ADMIN_ROLE_PARAMETER_PATH=groups
# OPENID_ADMIN_ROLE_TOKEN_KIND=id

# Local self-signed HTTPS only. Do not use in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
