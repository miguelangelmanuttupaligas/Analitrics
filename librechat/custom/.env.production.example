UID=1000
GID=1000
MONGO_UID=999
MONGO_GID=999
PORT=3080

# TLS is terminated by the VM Nginx. Docker is reachable only from that host.
GATEWAY_HTTP_PORT=127.0.0.1:3090
GATEWAY_HTTPS_PORT=127.0.0.1:3443
GATEWAY_CONFIG_TEMPLATE=host-nginx.conf.template
PUBLIC_HOST=analitrics.com
PUBLIC_PORT=443
PUBLIC_ORIGIN=https://analitrics.com
DOMAIN_CLIENT=https://analitrics.com
DOMAIN_SERVER=https://analitrics.com
ADMIN_PANEL_URL=https://analitrics.com/admin
ANALITRICS_DEFAULT_TENANT_ID=analitrics

CUSTOM_FOOTER=""
ADMIN_PANEL_SESSION_SECRET=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
CREDS_KEY=replace-with-openssl-rand-hex-32
CREDS_IV=replace-with-openssl-rand-hex-16
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
SEARCH=false
USE_REDIS=false
USE_REDIS_STREAMS=false

RAG_PORT=8000
RAG_POSTGRES_DB=librechat
RAG_POSTGRES_USER=librechat
RAG_POSTGRES_PASSWORD=replace-with-openssl-rand-base64-36
ANALITRICS_POSTGRES_DB=analitrics
ANALITRICS_POSTGRES_ADMIN_USER=analitrics
ANALITRICS_POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-24
ANALITRICS_POSTGRES_USER=analitrics_runtime
ANALITRICS_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
ANALITRICS_POSTGRES_HOST_PORT=55432
ANALITRICS_RECONCILE_INTERVAL_SECONDS=21600
ANALITRICS_MAX_FILE_BYTES=26214400
ANALITRICS_MAX_ACTIVE_CHATS_PER_USER=50
ANALITRICS_MAX_USER_MESSAGES_PER_CHAT=100
ANALITRICS_MAX_MEMORY_ITEMS=20
ANALITRICS_MAX_MEMORY_CHARS=4000

# Production uses OpenAI. Do not require Ollama or another local server on the VM.
ANALITRICS_LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
ANALITRICS_DEFAULT_MODEL=gpt-5.5
ANALITRICS_CHARTS_ENABLED=false

RUSTFS_ACCESS_KEY_ID=librechat
RUSTFS_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET_NAME=librechat
RUSTFS_CONSOLE_HOST_PORT=9001
RUSTFS_ANALYTICS_ACCESS_KEY_ID=analitrics-analytics-readonly
RUSTFS_ANALYTICS_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24

OPENID_CLIENT_ID=librechat
# Must match KEYCLOAK_LIBRECHAT_CLIENT_SECRET in keycloak/.env.
OPENID_CLIENT_SECRET=replace-with-openssl-rand-hex-32
OPENID_ISSUER=https://analitrics.com/auth/realms/analitrics
OPENID_SESSION_SECRET=replace-with-openssl-rand-hex-32
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Keycloak
OPENID_AUTO_REDIRECT=true
OPENID_REUSE_TOKENS=true
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_POST_LOGOUT_REDIRECT_URI=https://analitrics.com/login?redirect=false

# OPENID_ADMIN_ROLE=analitrics-admins
# OPENID_ADMIN_ROLE_PARAMETER_PATH=groups
# OPENID_ADMIN_ROLE_TOKEN_KIND=id

ADMIN_PANEL_SESSION_COOKIE_SECURE=true
