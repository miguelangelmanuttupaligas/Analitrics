HOST=localhost
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://mongodb:27017/LibreChat

UID=1000
GID=1000

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

NO_INDEX=true
TRUST_PROXY=1

JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars
CREDS_KEY=replace_with_64_hex_chars
CREDS_IV=replace_with_32_hex_chars
MEILI_MASTER_KEY=replace_with_random_string

OPENAI_API_KEY=user_provided
ASSISTANTS_API_KEY=user_provided

# Required for file embeddings in LibreChat RAG.
# Replace `user_provided` with a real key before testing CSV/XLSX uploads.
RAG_OPENAI_API_KEY=user_provided
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_PORT=8000
MCP_TIMEOUT=20000

# PostgreSQL propia de Analitrics para:
# - metadata de archivos
# - tablas importadas desde CSV/XLSX
# - datos corporativos de la demo
ANALITRICS_POSTGRES_DB=analitrics
ANALITRICS_POSTGRES_USER=analitrics
ANALITRICS_POSTGRES_PASSWORD=analitrics_local_2026
ANALITRICS_POSTGRES_PORT=5436
