UID=1000
GID=1000
MONGO_UID=999
MONGO_GID=999
PORT=3080

# Local development exposes the gateway on host ports 3090/3443.
# Production should normally keep these behind the VM reverse proxy on 80/443.
GATEWAY_HTTP_PORT=3090
GATEWAY_HTTPS_PORT=3443
PUBLIC_HOST=analitrics-test.com
ADMIN_PUBLIC_HOST=admin.analitrics-test.com

# Local development with the bundled self-signed certificate:
# PUBLIC_ORIGIN=https://analitrics-test.com:3443
# PUBLIC_PORT=3443
#
# Production behind the VM NGINX/TLS endpoint:
# PUBLIC_ORIGIN=https://analitrics.com
# PUBLIC_PORT=443
PUBLIC_PORT=443
ADMIN_PUBLIC_ORIGIN=https://admin.analitrics.com
ANALITRICS_DEFAULT_TENANT_ID=analitrics
PUBLIC_ORIGIN=https://analitrics.com

# In local development these should match PUBLIC_ORIGIN with :3443.
# In production these should stay without port.
DOMAIN_CLIENT=https://analitrics.com
DOMAIN_SERVER=https://analitrics.com

# LibreChat Admin Panel uses a distinct origin so LibreChat can run admin SSO.
# Local development: https://admin.analitrics-test.com:3443
# Production: https://admin.analitrics.com
ADMIN_PANEL_URL=https://admin.analitrics.com
CUSTOM_FOOTER=""
ADMIN_PANEL_SESSION_SECRET=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
CREDS_KEY=replace-with-openssl-rand-hex-32
CREDS_IV=replace-with-openssl-rand-hex-16
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
SEARCH=false
USE_REDIS=false
USE_REDIS_STREAMS=false
RAG_PORT=8000
RAG_POSTGRES_DB=librechat
RAG_POSTGRES_USER=librechat
RAG_POSTGRES_PASSWORD=replace-with-openssl-rand-base64-36

RUSTFS_ACCESS_KEY_ID=librechat
RUSTFS_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET_NAME=librechat

OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=replace-with-keycloak-client-secret

# Local development: https://analitrics-test.com:3443/auth/realms/analitrics
# Production: https://analitrics.com/auth/realms/analitrics
OPENID_ISSUER=https://analitrics.com/auth/realms/analitrics
OPENID_SESSION_SECRET=replace-with-openssl-rand-hex-32
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Keycloak
OPENID_AUTO_REDIRECT=true

# Required so LibreChat logout also closes the Keycloak SSO session.
# Local development: https://analitrics-test.com:3443/login?redirect=false
# Production: https://analitrics.com/login?redirect=false
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_POST_LOGOUT_REDIRECT_URI=https://analitrics.com/login?redirect=false

# Future admin elevation from Keycloak:
# 1. Create a Keycloak group or role, for example analitrics-admins.
# 2. Emit it in the ID token as claim groups.
# 3. Uncomment these so LibreChat promotes matching users to ADMIN on login.
# OPENID_ADMIN_ROLE=analitrics-admins
# OPENID_ADMIN_ROLE_PARAMETER_PATH=groups
# OPENID_ADMIN_ROLE_TOKEN_KIND=id

# Local self-signed HTTPS only. Do not use in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
