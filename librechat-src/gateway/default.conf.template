map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name ${PUBLIC_HOST};

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen 3443 ssl;
  server_name ${PUBLIC_HOST};

  ssl_certificate /etc/nginx/certs/analitrics.crt;
  ssl_certificate_key /etc/nginx/certs/analitrics.key;

  client_max_body_size 25m;

  location = /login {
    if ($arg_redirect != "false") {
      return 302 https://$http_host/oauth/openid;
    }

    proxy_pass http://api:${PORT};
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};

    proxy_set_header X-Tenant-Id "${ANALITRICS_DEFAULT_TENANT_ID}";

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
  }

  location = /login/ {
    return 302 https://$http_host/oauth/openid;
  }

  location = /register {
    return 302 https://$http_host/oauth/openid;
  }

  location = /admin {
    return 302 ${ADMIN_PUBLIC_ORIGIN}/;
  }

  location = /auth {
    return 301 /auth/;
  }

  location = /api/files {
    proxy_pass http://upload-file-wrapper:3096;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};

    # Trust boundary: overwrite any client-supplied tenant header.
    proxy_set_header X-Tenant-Id "${ANALITRICS_DEFAULT_TENANT_ID}";

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
  }

  location /admin/ {
    return 302 ${ADMIN_PUBLIC_ORIGIN}/;
  }

  location /auth/ {
    proxy_pass http://keycloak:8080/auth/;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
  }

  location / {
    proxy_pass http://api:${PORT};
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};

    # Trust boundary: overwrite any client-supplied tenant header.
    proxy_set_header X-Tenant-Id "${ANALITRICS_DEFAULT_TENANT_ID}";

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
  }
}

server {
  listen 80;
  server_name ${ADMIN_PUBLIC_HOST};

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen 3443 ssl;
  server_name ${ADMIN_PUBLIC_HOST};

  ssl_certificate /etc/nginx/certs/analitrics.crt;
  ssl_certificate_key /etc/nginx/certs/analitrics.key;

  client_max_body_size 25m;

  location / {
    proxy_pass http://admin-panel:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
  }
}
