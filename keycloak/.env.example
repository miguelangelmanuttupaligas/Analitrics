KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=replace-with-openssl-rand-base64-36
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-openssl-rand-base64-24

# Local development with gateway HTTPS on :3443:
# KC_HOSTNAME=https://analitrics-test.com:3443/auth
# KC_HOSTNAME_ADMIN=https://analitrics-test.com:3443/auth
#
# Production behind the VM NGINX/TLS endpoint:
# KC_HOSTNAME=https://analitrics.com/auth
# KC_HOSTNAME_ADMIN=https://analitrics.com/auth
KC_HOSTNAME=https://analitrics.com/auth
KC_HOSTNAME_ADMIN=https://analitrics.com/auth
