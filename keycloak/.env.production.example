KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=replace-with-openssl-rand-base64-36
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-openssl-rand-base64-24

# Must match OPENID_CLIENT_SECRET in librechat/custom/.env.
KEYCLOAK_LIBRECHAT_CLIENT_SECRET=replace-with-openssl-rand-hex-32
KEYCLOAK_PUBLIC_ORIGIN=https://analitrics.com
KC_START_MODE=start
KC_HOSTNAME=https://analitrics.com/auth
KC_HOSTNAME_ADMIN=https://analitrics.com/auth
